# mock | supabase
EXPO_PUBLIC_DATA_MODE=mock

# Required when EXPO_PUBLIC_DATA_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public links shown in Settings / App Store metadata
EXPO_PUBLIC_PRIVACY_URL=https://orbit.app/privacy
EXPO_PUBLIC_TERMS_URL=https://orbit.app/terms

# Server-only secrets — set in Supabase Edge Function secrets / EAS secrets, never in the client
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
