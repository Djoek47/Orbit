# Current default for Expo Go development: mock
# Switch to supabase for live household sync + join approval persistence
EXPO_PUBLIC_DATA_MODE=mock

# Optional: enable live OpenAI Poppins while household data stays mock
# Set to openai when edge functions are deployed (requires Supabase URL/key for invoke)
EXPO_PUBLIC_POPPINS_AI=mock

# OpenAI Realtime voice on Poppins tab (needs EXPO_PUBLIC_POPPINS_AI=openai or supabase mode + poppins-realtime-session deployed)
# Falls back to Whisper + TTS via poppins-voice when unset or session fails
EXPO_PUBLIC_POPPINS_REALTIME=0

# Required when EXPO_PUBLIC_DATA_MODE=supabase or EXPO_PUBLIC_POPPINS_AI=openai
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public links shown in Settings / App Store metadata
EXPO_PUBLIC_PRIVACY_URL=https://choremaxx.app/privacy
EXPO_PUBLIC_TERMS_URL=https://choremaxx.app/terms

# --- TestFlight / EAS production builds (set in EAS secrets, not committed) ---
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value ...
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value ...
# See docs/testflight-setup.md

# Server-only secrets — set in Supabase Edge Function secrets / EAS secrets, never in the client
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Resend: prefer Custom SMTP in Supabase Auth (password = API key). Hook path also needs:
# RESEND_API_KEY=
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# RESEND_FROM_EMAIL=Choremaxx <noreply@choremaxx.app>
# See docs/resend-auth-email.md
