# Current default for Expo Go development: mock
# Switch to supabase for live household sync + join approval persistence
EXPO_PUBLIC_DATA_MODE=mock

# Optional: enable live OpenAI Nova while household data stays mock
# Set to openai when edge functions are deployed (requires Supabase URL/key for invoke)
EXPO_PUBLIC_NOVA_AI=mock

# OpenAI Realtime voice on Nova tab (needs EXPO_PUBLIC_NOVA_AI=openai or supabase mode + nova-realtime-session deployed)
# Falls back to Whisper + TTS via nova-voice when unset or session fails
EXPO_PUBLIC_NOVA_REALTIME=0

# Required when EXPO_PUBLIC_DATA_MODE=supabase or EXPO_PUBLIC_NOVA_AI=openai
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public links shown in Settings / App Store metadata
EXPO_PUBLIC_PRIVACY_URL=https://orbit.app/privacy
EXPO_PUBLIC_TERMS_URL=https://orbit.app/terms

# Server-only secrets — set in Supabase Edge Function secrets / EAS secrets, never in the client
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
