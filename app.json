{
  "expo": {
    "name": "Choremaxx",
    "slug": "choremaxx",
    "version": "1.0.0",
    "description": "Choremaxx is an AI household operating system — tasks, rewards, groceries, and Nova your calm co-manager.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "choremaxx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "linking": {
      "prefixes": [
        "choremaxx://",
        "https://choremaxx.app",
        "orbit://",
        "https://orbit.app"
      ],
      "config": {
        "screens": {
          "join/[code]": "join/:code",
          "auth/callback": "auth/callback",
          "confirm-email": "confirm-email"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.choremaxx.household",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Choremaxx uses the microphone so you can talk to Nova.",
        "NSLocationWhenInUseUsageDescription": "Choremaxx uses your location for nearby grocery suggestions.",
        "NSCameraUsageDescription": "Choremaxx uses the camera to scan invite QR codes and attach task proof photos.",
        "NSPhotoLibraryUsageDescription": "Choremaxx uses your photos for profile pictures and task proof attachments.",
        "NSPhotoLibraryAddUsageDescription": "Choremaxx can save task proof photos to your library when you choose.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "app.choremaxx.household",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#D85A30",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#D85A30"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Choremaxx uses your location for nearby grocery suggestions."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Choremaxx uses the microphone so you can talk to Nova."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Choremaxx uses the camera to scan invite QR codes and attach task proof photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choremaxx uses your photos for profile pictures and task proof attachments."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#070D1C",
          "dark": {
            "backgroundColor": "#070D1C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://choremaxx.app/privacy",
      "termsUrl": "https://choremaxx.app/terms",
      "eas": {
        "projectId": "01af7128-865e-4d2e-b0b1-836f03105fc8"
      }
    },
    "owner": "djoek47",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01af7128-865e-4d2e-b0b1-836f03105fc8"
    }
  }
}
