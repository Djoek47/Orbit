{
  "name": "orbit",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start --go",
    "start:lan": "npx expo start --go --lan",
    "start:tunnel": "npx expo start --tunnel --go",
    "start:persistent": "bash ./scripts/expo-keep-alive.sh",
    "expo:watchdog": "bash ./scripts/expo-persistent.sh",
    "expo:health": "bash ./scripts/expo-healthcheck.sh --verbose",
    "expo:health:json": "bash ./scripts/expo-healthcheck.sh --json",
    "expo:keep-alive:test": "bash ./scripts/test-expo-keep-alive.sh",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "lint": "npx expo lint",
    "typecheck": "npx tsc --noEmit",
    "test:trophies": "npx --yes tsx lib/trophies/trophy-engine.test.ts",
    "figma:check": "node ./scripts/figma-sync-check.js",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:testflight": "eas build --platform ios --profile testflight",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "submit:ios:testflight": "eas submit --platform ios --profile testflight --latest",
    "submit:android": "eas submit --platform android --profile production",
    "testflight:preflight": "bash ./scripts/testflight-preflight.sh",
    "qr:expo": "node scripts/write-expo-qr.mjs",
    "test:reward-mode": "npx --yes tsx lib/rewards/reward-mode.test.ts",
    "test:streak-engine": "npx --yes tsx lib/streaks/streak-engine.test.ts",
    "test:today": "npx --yes tsx lib/tasks/today.test.ts",
    "test:completion-xp": "npx --yes tsx lib/tasks/completion-xp.test.ts",
    "test:daily-streak": "npx --yes tsx lib/streaks/daily-streak.test.ts",
    "test:claim-reward": "npx --yes tsx lib/rewards/claim-reward.test.ts",
    "test:logic": "npm run test:reward-mode && npm run test:streak-engine && npm run test:trophies && npm run test:today && npm run test:completion-xp && npm run test:daily-streak && npm run test:claim-reward && npm run test:task-library && npm run test:task-library-v2 && npm run test:proof-actions && npm run test:recurrence-defaults && npm run test:recurring",
    "test:task-library": "npx --yes tsx scripts/validate-task-library.ts",
    "test:task-library-v2": "npx --yes tsx lib/tasks/task-library.test.ts",
    "test:recurrence-defaults": "npx --yes tsx lib/tasks/recurrence-defaults.test.ts",
    "test:proof-actions": "npx --yes tsx lib/tasks/proof-actions.test.ts",
    "test:recurring": "npx --yes tsx lib/tasks/recurring.test.ts",
    "generate:brand-marks": "node scripts/generate-brand-marks.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.108.1",
    "date-fns": "^4.4.0",
    "expo": "~54.0.34",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "torch-image-playground": "^0.2.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "eas-cli": "^16.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
