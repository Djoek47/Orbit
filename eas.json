{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "supabase"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "supabase"
      }
    },
    "testflight": {
      "extends": "production",
      "channel": "testflight",
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "supabase",
        "EXPO_PUBLIC_NOVA_AI": "openai"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "supabase",
        "EXPO_PUBLIC_NOVA_AI": "openai"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "REPLACE_ASC_APP_ID"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "REPLACE_ASC_APP_ID"
      }
    }
  }
}
